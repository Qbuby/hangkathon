# Signing key for the session cookie. Generate one with `npx auth secret`.
AUTH_SECRET=

# GitHub OAuth App. Callback: https://hangkathon.net/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth 2.0 client. Redirect URI: https://hangkathon.net/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 微信开放平台「网站应用」（PC 扫码登录，snsapi_login）。授权回调域：hangkathon.com
# 回调地址：https://hangkathon.com/api/auth/callback/wechat
# 真实凭据只放服务器 .env，不进 git。
AUTH_WECHAT_ID=
AUTH_WECHAT_SECRET=

# 管理端口（/manage）：逗号分隔的登录邮箱名单，部署时自动提权为 admin（幂等，不降级名单外用户）。
# ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=

# 飞书自建应用告警（deploy/feishu-alert.mjs 用）。真实凭据只放服务器 .env，不进 git。
# 取 receive_id 的方法见 deploy/feishu-alert.mjs 顶部注释。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
# 群用 chat_id，个人用 open_id；默认 chat_id
FEISHU_RECEIVE_ID_TYPE=chat_id

# 带外死人开关（dead man's switch）。填 Healthchecks.io 某个 check 的 ping URL，
# 形如 https://hc-ping.com/<uuid>。任务每轮 ping 它：备份 / 自检 / 部署三条链都埋了点。
# 超过 period+grace 没收到，就由**服务器之外**的那一端告警 ——
# 这是整机宕机 / Docker 全挂 / 网络不通时唯一还能响的一层（Kuma 与飞书都同故障域）。
# 不填则降级为写日志，其余功能不受影响。建议建三个 check：
#   backup（周期 24h / 宽限 1h）、integrity（24h / 1h）、ci（10min / 5min）
# 日任务在 03:20–04:10 之间跑且带最多 10 分钟随机延迟，周期别卡太紧。
HEALTHCHECK_PING_URL=
