# Signing key for the session cookie. Generate one with `npx auth secret`.
AUTH_SECRET=

# GitHub OAuth App. Callback: https://hangkathon.net/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth 2.0 client. Redirect URI: https://hangkathon.net/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 管理端口（/manage）：逗号分隔的登录邮箱名单，部署时自动提权为 admin（幂等，不降级名单外用户）。
# ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=
