# Signing key for the session cookie. Generate one with `npx auth secret`.
AUTH_SECRET=

# GitHub OAuth App. Callback: https://hangkathon.net/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth 2.0 client. Redirect URI: https://hangkathon.net/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 微信开放平台「网站应用」（PC 扫码登录，snsapi_login）。授权回调域：hangkathon.com
# 回调地址：https://hangkathon.com/api/auth/callback/wechat
# 真实凭据只放服务器 .env，不进 git。
AUTH_WECHAT_ID=
AUTH_WECHAT_SECRET=

# 管理端口（/manage）：逗号分隔的登录邮箱名单，部署时自动提权为 admin（幂等，不降级名单外用户）。
# ADMIN_EMAILS=you@example.com,another@example.com
ADMIN_EMAILS=

# 飞书自建应用告警（deploy/feishu-alert.mjs 用）。真实凭据只放服务器 .env，不进 git。
# 取 receive_id 的方法见 deploy/feishu-alert.mjs 顶部注释。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_RECEIVE_ID=
# 群用 chat_id，个人用 open_id；默认 chat_id
FEISHU_RECEIVE_ID_TYPE=chat_id

# 飞书「群自定义机器人」webhook —— 有人提交代理商申请时往群里发提醒
# （lib/server/feishu-webhook.ts 用；这是应用进程内调用，与上面那套自建应用是两种形态）。
#
# 取法：群里「设置 → 群机器人 → 添加机器人 → 自定义机器人」→ 复制 Webhook 地址，
# 形如 https://open.feishu.cn/open-apis/bot/v2/hook/<uuid>
#
# **这条 URL 等同于密码**：拿到它就能往群里发消息。只放服务器 .env（600 权限），绝不进 git
# —— scripts/feishu-webhook.test.mjs 与 scripts/ci/drift-guard.mjs 都会因源码里出现
# 硬编码的 webhook 字面量而失败。
#
# 不填也能用：模块降级为"只在服务器日志里记一句"，申请流程完全不受影响。
FEISHU_WEBHOOK_URL=

# ── 飞书管理命令（在群里 @机器人 直接操作 /manage）─────────────────────────
# 与上面两个变量是**两件事**：
#   FEISHU_WEBHOOK_URL = 群自定义机器人，只能**发**，用来推送提醒；
#   FEISHU_APP_ID/SECRET = 自建应用，能**收**能发，事件订阅到本站的 /api/feishu/events。
# 群里会显示成两个不同的机器人，别混淆。

# 事件订阅的 Encrypt Key（飞书后台「事件与回调 → 加密策略 → Encrypt Key」）。
# **不配就等于把管理端口开到公网**：没有它就没有验签，/api/feishu/events 会整体返回 503，
# 宁可不可用也不能无验签运行。取到的字符串只放服务器 .env。
FEISHU_ENCRYPT_KEY=

# 管理员白名单：`open_id=站内邮箱`，逗号分隔；一个 open_id 可绑多个邮箱，用 `|` 分隔。
# 例：
#   FEISHU_ADMINS="ou_aaa123=owner@example.com|other@example.com,ou_bbb456=ops@example.com"
#
# **值必须用双引号包起来。** .env 会被解析（不是被 shell 求值），但**管道符 `|` 在
# 未加引号时仍会被某些路径当管道处理** —— 2026-10-17 就因为这个导致每日备份静默中断两天
# （见 docs/ci-testing.md 第六节第 9 条）。加引号是必须的，不是可选的美观。
#
# 为什么用 open_id 而不是邮箱：飞书的消息事件里**只有 open_id**，不返回邮箱。
# 为什么还要绑邮箱：远程操作必须解析成一个**真实的站内用户** ——
# agent_applications.reviewed_by 是指向 users.id 的 uuid 外键，setUserRole/deleteUser
# 还要用 operatorId 做"不能改自己"的判断。绑不上邮箱（或绑到的不是 admin）一律拒绝。
#
# 拿自己的 open_id：在群里 @机器人 发任意命令，未授权时会回一条说明，
# 同时把 open_id 记进管理端审计日志（category=security, action=feishu.bot.denied）。
FEISHU_ADMINS=

# 带外死人开关（dead man's switch）。填 Healthchecks.io 某个 check 的 ping URL，
# 形如 https://hc-ping.com/<uuid>。任务每轮 ping 它：备份 / 自检 / 部署三条链都埋了点。
# 超过 period+grace 没收到，就由**服务器之外**的那一端告警 ——
# 这是整机宕机 / Docker 全挂 / 网络不通时唯一还能响的一层（Kuma 与飞书都同故障域）。
# 不填则降级为写日志，其余功能不受影响。建议建三个 check：
#   backup（周期 24h / 宽限 1h）、integrity（24h / 1h）、ci（10min / 5min）
# 日任务在 03:20–04:10 之间跑且带最多 10 分钟随机延迟，周期别卡太紧。
HEALTHCHECK_PING_URL=
