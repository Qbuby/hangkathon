/* 排行榜 —— 对齐网页 leaderboard.css：
   页头（LEADERBOARD / 排行榜 / 说明）→ 四宫格统计 →
   各区统计（单列卡片，彩色圆点）→ 战队 → 个人榜。 */

/* ── 页头 ─────────────────────────────────────────────────────────────── */
.lb-hero {
  padding: 56rpx 40rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2ecf6;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.lb-title {
  font-size: 56rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
  color: #17273a;
}

.lb-sub {
  font-size: 26rpx;
  line-height: 1.9;
  color: #7c93a8;
}

/* ── 四宫格统计 ───────────────────────────────────────────────────────── */
.stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 32rpx 24rpx 0;
}

.stat {
  padding: 32rpx 28rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(23, 58, 102, 0.05);
}

.stat-num {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #17273a;
}

.stat-label {
  font-size: 23rpx;
  letter-spacing: 1rpx;
  color: #8fa6bb;
}

/* ── 分区 ─────────────────────────────────────────────────────────────── */
.lb-section {
  padding: 48rpx 40rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #5f7f9e;
}

.section-title {
  font-size: 38rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  color: #17273a;
}

.explain {
  font-size: 25rpx;
  line-height: 1.85;
  color: #7c93a8;
}

/* ── 各区统计（单列卡片）────────────────────────────────────────────── */
.district-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 12rpx;
}

.district-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 30rpx;
  background: #fff;
  border: 1rpx solid #e3edf6;
  border-radius: 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(23, 58, 102, 0.04);
}

.district-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex: none;
}

.district-name {
  flex: 1;
  font-size: 29rpx;
  font-weight: 600;
  color: #17273a;
}

.district-count {
  font-size: 25rpx;
  color: #8fa6bb;
}

/* ── 排行榜表 ─────────────────────────────────────────────────────────── */
.rank-list {
  margin-top: 16rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 22rpx;
  padding: 8rpx 26rpx;
}

.rank-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #eef3f8;
}

.rank-row:last-child {
  border-bottom: none;
}

.rank-no {
  width: 56rpx;
  flex: none;
  font-size: 26rpx;
  font-weight: 600;
  color: #8fa6bb;
}

.rank-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.rank-name {
  font-size: 29rpx;
  font-weight: 600;
  color: #17273a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank-meta {
  font-size: 22rpx;
  color: #8fa6bb;
}

.rank-points {
  font-size: 29rpx;
  font-weight: 600;
  color: #c9952a;
}

/* 我的荣誉占位卡（对齐网页 lb-me） */
.my-honor {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border: 1rpx dashed #8fd0ff;
  border-radius: 22rpx;
}

.my-honor-tag {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #e3f4ff;
  border: 1rpx solid #b9dcf5;
  color: #0b6fa8;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.my-honor-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.my-honor-title {
  font-size: 30rpx;
  font-weight: 650;
  color: #17273a;
}

.my-honor-sub {
  font-size: 24rpx;
  line-height: 1.7;
  color: #8fa6bb;
}

.empty.small {
  padding: 40rpx 20rpx;
  font-size: 24rpx;
  color: #8fa6bb;
}

.retry {
  margin-top: 24rpx;
  width: 240rpx;
}
