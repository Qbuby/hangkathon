/* 详情页 —— 对齐网页 detail.css 的骨架：深色标题区不渐变、白底内容区、
   关键信息卡用浅蓝描边、报名按钮是蓝色药丸。 */

/* ── 标题区 ───────────────────────────────────────────────────────────── */
.detail-hero {
  padding: 56rpx 40rpx 40rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2ecf6;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.hero-title {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: 2rpx;
  color: #17273a;
}

.hero-sub {
  font-size: 28rpx;
  line-height: 1.7;
  color: #7c93a8;
}

.hero-line {
  font-size: 25rpx;
  color: #8fa6bb;
  letter-spacing: 0.5rpx;
}

/* ── 关键信息 ─────────────────────────────────────────────────────────── */
.facts {
  margin: 32rpx 24rpx 0;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.facts-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #17273a;
}

.fact-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.fact-label {
  font-size: 23rpx;
  color: #8fa6bb;
  letter-spacing: 1rpx;
}

.fact-value-wrap {
  display: flex;
}

.fact-value {
  font-size: 27rpx;
  color: #17273a;
  line-height: 1.6;
  white-space: pre-wrap;
}

.fact-district {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 27rpx;
  color: #17273a;
}

.fact-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex: none;
}

/* ── 正文段落 ─────────────────────────────────────────────────────────── */
.section {
  margin: 32rpx 24rpx 0;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #5f7f9e;
}

.section-title {
  font-size: 34rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  color: #17273a;
}

.section-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5f7d99;
  letter-spacing: 1rpx;
}

.section-text {
  font-size: 27rpx;
  line-height: 1.9;
  color: #42566b;
  white-space: pre-wrap;
}

.section-hint {
  font-size: 23rpx;
  color: #9fb2c4;
  line-height: 1.7;
}

/* ── 报名卡 ───────────────────────────────────────────────────────────── */
.join-card {
  margin: 32rpx 24rpx 0;
  padding: 32rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 58, 102, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.join-title {
  font-size: 32rpx;
  font-weight: 650;
  color: #17273a;
}

.join-badge {
  align-self: flex-start;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 24rpx;
  border-radius: 40rpx;
  background: #e3f4ff;
  border: 1rpx solid #b9dcf5;
  color: #0b6fa8;
  font-size: 25rpx;
}

.join-badge-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #1b9cfc;
}

.join-note {
  font-size: 24rpx;
  line-height: 1.8;
  color: #7c93a8;
}

.join-action {
  margin-top: 4rpx;
}

/* ── 作品列表 ─────────────────────────────────────────────────────────── */
.work-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.work-row {
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f6fafd;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.work-url {
  font-size: 24rpx;
  color: #0b6fa8;
  word-break: break-all;
}

.work-meta {
  font-size: 22rpx;
  color: #8fa6bb;
}

.retry {
  margin-top: 24rpx;
  width: 240rpx;
}
