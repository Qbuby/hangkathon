<view class="page">
  <view wx:if="{{loading}}" class="loading">正在读取活动…</view>

  <view wx:elif="{{error}}" class="empty">
    <text>{{error}}</text>
    <button class="btn btn-ghost retry" bindtap="load">重新加载</button>
  </view>

  <block wx:elif="{{activity}}">
    <!-- ── 标题区（对齐网页 detail-hero）───────────────────────────── -->
    <view class="detail-hero">
      <text class="hero-title">{{activity.title}}</text>
      <text wx:if="{{activity.subtitle}}" class="hero-sub">{{activity.subtitle}}</text>
      <text wx:if="{{activity.host}}" class="hero-line">主办方 · {{activity.host}}</text>
      <text wx:if="{{activity.contact}}" class="hero-line">联系方式 · {{activity.contact}}</text>
    </view>

    <!-- ── 关键信息（对齐 detail-facts）────────────────────────────── -->
    <view class="facts">
      <text class="facts-title">关键信息</text>
      <view wx:for="{{facts}}" wx:key="label" class="fact-row">
        <text class="fact-label">{{item.label}}</text>
        <view class="fact-value-wrap">
          <view wx:if="{{item.color}}" class="fact-district">
            <view class="fact-dot" style="background: {{item.color}}"></view>
            <text>{{item.value}}</text>
          </view>
          <text wx:else class="fact-value">{{item.value}}</text>
        </view>
      </view>
    </view>

    <!-- ── 活动说明（对齐 detail-section）──────────────────────────── -->
    <view class="section">
      <text class="eyebrow">WHAT YOU DO</text>
      <text class="section-title">你要做什么</text>
      <text class="section-text">{{activity.overview || '主办方还没有填写活动说明。'}}</text>

      <block wx:if="{{activity.criteriaText}}">
        <text class="section-label">评审维度</text>
        <text class="section-text">{{activity.criteriaText}}</text>
      </block>

      <block wx:if="{{activity.awardsText}}">
        <text class="section-label">奖项</text>
        <text class="section-text">{{activity.awardsText}}</text>
      </block>

      <text class="section-label">参加流程</text>
      <text class="section-text">发现活动 → 报名参加 → 完成作品/任务 → 获得荣誉。报名后可在本页提交抖音作品链接。</text>
    </view>

    <!-- ── 报名区（对齐 detail-join）──────────────────────────────── -->
    <view class="join-card">
      <block wx:if="{{joined}}">
        <text class="join-title">已报名 · 个人参赛</text>
        <view class="join-badge">
          <view class="join-badge-dot"></view>
          <text>个人参赛</text>
        </view>
        <text class="join-note">{{joinCount}} 人已报名 · 报名后照「怎么参加」四步走就行。</text>

        <button class="btn btn-primary btn-block join-action" bindtap="onSubmitWork">提交作品</button>
        <button class="btn btn-ghost btn-block join-action" bindtap="onInvite">
          {{inviteCopied ? '邀请链接已复制' : '复制邀请链接'}}
        </button>
      </block>

      <block wx:else>
        <text class="join-title">想参加这场活动？</text>
        <button class="btn btn-primary btn-block" loading="{{joining}}" disabled="{{joining}}" bindtap="onJoin">
          {{joining ? '报名中…' : '登录后报名'}}
        </button>
        <text class="join-note">个人一键报名。报名后照着「怎么参加」四步走就行。</text>
      </block>
    </view>

    <!-- ── 我的作品 ───────────────────────────────────────────────── -->
    <view wx:if="{{joined}}" class="section">
      <text class="eyebrow">MY WORKS</text>
      <text class="section-title">我的作品</text>
      <view wx:if="{{mySubmissions.length === 0}}" class="section-text">
        还没有提交过作品。可以反复提交，每次提交都会进入审核队列。
      </view>
      <view wx:else class="work-list">
        <view wx:for="{{mySubmissions}}" wx:key="url" class="work-row" data-url="{{item.url}}" bindtap="onCopyWork">
          <text class="work-url">{{item.url}}</text>
          <text class="work-meta">
            {{item.diggCount !== undefined ? '赞 ' + item.diggCount : '尚未抓到数据'}}
          </text>
        </view>
      </view>
      <text class="section-hint">提交记录保存在平台，只有你自己能看到。</text>
    </view>
  </block>
</view>
