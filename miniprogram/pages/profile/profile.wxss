/* 我的 —— 对齐网页 profile.css 的勋章卡：
   白色圆角卡、HONOR · 数字杭州市民 小标题、大字昵称、五颗星、
   金色档位文字、大号贡献值、进度条。 */

/* ── 勋章卡 ───────────────────────────────────────────────────────────── */
.medal {
  margin: 32rpx 24rpx 0;
  padding: 40rpx 32rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(23, 58, 102, 0.06);
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.medal-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #5f7f9e;
}

.medal-identity {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #e3f4ff;
  border: 1rpx solid #cfe1f2;
  color: #0b6fa8;
  font-weight: 600;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
}

.medal-name {
  font-size: 48rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  color: #17273a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.stars {
  display: flex;
  gap: 12rpx;
}

.star {
  font-size: 44rpx;
  line-height: 1;
}

.star.on {
  color: #f0b429;
}

.star.off {
  color: #dce4ee;
}

.medal-title {
  font-size: 27rpx;
  letter-spacing: 1rpx;
  color: #c9952a;
}

.points {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-top: 8rpx;
}

.points-num {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #17273a;
}

.points-label {
  font-size: 24rpx;
  letter-spacing: 1rpx;
  color: #8fa6bb;
}

.progress-bar {
  height: 14rpx;
  border-radius: 8rpx;
  background: #e8f0f8;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #5fc8ff, #1b9cfc);
}

.medal-next {
  font-size: 24rpx;
  color: #8fa6bb;
}

.medal-note {
  font-size: 24rpx;
  line-height: 1.85;
  color: #8fa6bb;
}

/* ── 分区（对齐 profile 的 ACTIVITIES 段）────────────────────────────── */
.profile-section {
  padding: 48rpx 40rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.detail-eyebrow {
  font-size: 20rpx;
  letter-spacing: 5rpx;
  color: #5f7f9e;
}

.section-title {
  font-size: 38rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
  color: #17273a;
}

.section-sub {
  font-size: 24rpx;
  color: #8fa6bb;
}

/* 报名行 */
.join-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 10rpx;
}

.join-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 28rpx 30rpx;
  background: #fff;
  border: 1rpx solid #e3edf6;
  border-radius: 20rpx;
  box-shadow: 0 1rpx 8rpx rgba(23, 58, 102, 0.04);
}

.join-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.join-title {
  font-size: 29rpx;
  font-weight: 600;
  color: #17273a;
}

.join-date {
  font-size: 23rpx;
  color: #8fa6bb;
}

.join-arrow {
  font-size: 34rpx;
  color: #b9cee0;
}

/* ── 未登录卡 ─────────────────────────────────────────────────────────── */
.login-card {
  margin: 60rpx 24rpx 0;
  padding: 40rpx 32rpx;
  background: #fff;
  border: 1rpx solid #dce7f2;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  color: #17273a;
}

.login-body {
  font-size: 26rpx;
  line-height: 1.9;
  color: #7c93a8;
}

.login-btn {
  margin-top: 8rpx;
}

.tiny {
  font-size: 22rpx;
  line-height: 1.7;
  color: #9fb2c4;
}

/* ── 更多操作 ─────────────────────────────────────────────────────────── */
.more-actions {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.retry {
  margin-top: 24rpx;
  width: 240rpx;
}
