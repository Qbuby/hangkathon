# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/.wrangler/
# Checkout-local execution profile and tool state; never publish them.
/.sites-runtime/
/.agents/
/.codex/
/outputs/
/work/

*.tsbuildinfo

# python bytecode (scripts/douyin runs python, nothing else does)
__pycache__/
*.pyc
pentest-evidence/

# 微信开发者工具会自动写入：真实 AppID、本地私有设置、上传记录
# project.config.json 是**要**提交的（含占位 AppID + 编译配置），但下面这些是本机状态
miniprogram/project.private.config.json
miniprogram/.idea/
miniprogram/node_modules/
miniprogram/miniprogram_npm/
