[Unit]
Description=杭客松每日备份（数据库 + 审计日志 CSV）
Documentation=file:/opt/hangkathon/deploy/README.md
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/hangkathon
EnvironmentFile=/opt/hangkathon/.env
ExecStart=/bin/sh /opt/hangkathon/deploy/backup.sh
TimeoutStartSec=1800
Nice=10
IOSchedulingClass=idle